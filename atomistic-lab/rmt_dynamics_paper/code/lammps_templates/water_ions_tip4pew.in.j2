## TIP4P-Ew water with Joung-Cheatham monovalent ions (Experiment 7).
## Parameters from the OpenMM amber14/tip4pew.xml force field (Joung &
## Cheatham, J. Phys. Chem. B 112, 9020 (2008); Horn et al., J. Chem. Phys.
## 120, 9665 (2004)), converted from nm, kJ/mol to Angstrom, kcal/mol.
## Atom types: 1 O (carries the M-site charge), 2 H, 3 cation, 4 anion.
##
## Jinja2 context: seed, data_file, temperature, pressure, timestep, cutoff,
## premelt_T, premelt_steps, n_equil, n_prod, sample_every, out_dump,
## cation_sigma, cation_epsilon, anion_sigma, anion_epsilon

units           real
atom_style      full
boundary        p p p
read_data       {{ data_file }}

pair_style      lj/cut/tip4p/long 1 2 1 1 0.125 {{ cutoff }}
pair_modify     mix arithmetic tail yes
pair_coeff      1 1 0.16275 3.16435
pair_coeff      2 2 0.0 1.0
pair_coeff      3 3 {{ cation_epsilon }} {{ cation_sigma }}
pair_coeff      4 4 {{ anion_epsilon }} {{ anion_sigma }}
pair_coeff      2 3 0.0 1.0
pair_coeff      2 4 0.0 1.0

bond_style      harmonic
bond_coeff      1 0.0 0.9572
angle_style     harmonic
angle_coeff     1 0.0 104.52
kspace_style    pppm/tip4p 1.0e-5

fix             rigid all shake 1.0e-4 100 0 b 1 a 1

velocity        all create {{ premelt_T }} {{ seed }} mom yes rot yes dist gaussian
timestep        {{ timestep }}
thermo          1000
thermo_style    custom step temp etotal press vol density

fix             melt all nvt temp {{ premelt_T }} {{ premelt_T }} 100.0
run             {{ premelt_steps }}
unfix           melt

fix             integrate all npt temp {{ temperature }} {{ temperature }} 100.0 iso {{ pressure }} {{ pressure }} 1000.0
run             {{ n_equil }}

reset_timestep  0
dump            d_pos all custom {{ sample_every }} {{ out_dump }} id type xu yu zu
dump_modify     d_pos sort id
run             {{ n_prod }}
