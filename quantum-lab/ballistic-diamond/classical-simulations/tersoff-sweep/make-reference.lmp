# ============================================================
# Pristine reference state for Wigner-Seitz damage analysis.
#
# Identical lattice, box, potential and warmup to simulate.lmp, but NO ion
# and no collision/quench.  The resulting equilibrated slab defines the
# reference lattice SITES used to identify vacancies and interstitials.
#
# Why this exists: a perfect analytic lattice cannot be registered reliably
# across a 3300 A slab.  The real slab is laterally clamped by the periodic
# box and free along z, so it carries a relaxation/strain profile that is
# not a rigid shift plus a linear term.  Comparing a damaged run against a
# slab that relaxed the SAME way removes the registration problem entirely.
#
# Placeholders ORIENTATION / TEMPERATURE are substituted by the caller.
# ============================================================

units       metal
dimension   3
boundary    p p f
atom_style  atomic

variable    orientation equal ORIENTATION
variable    temperature equal TEMPERATURE
variable    rseed        index 777
variable    warmup_steps index 25000

variable    rseed_c      equal (v_rseed%899999990)+1
variable    seed_diamond equal v_rseed_c+1
variable    seed_eq      equal v_rseed_c+4

variable    pot_root    string /home/stovey/work/projects/quantum-lab/ballistic-diamond
variable    tersoff_pot string ${pot_root}/classical-simulations/potentials/C.tersoff.zbl
variable    outdir      string /work/stovey/ballistic-diamond/references

variable    alat        equal 3.5678

if "${orientation} == 100" then &
    "lattice diamond ${alat} orient x 1 0 0 orient y 0 1 0 orient z 0 0 1" &
    "variable ylat_hi equal 20" &
    "variable slab_hi equal 940"
if "${orientation} == 110" then &
    "lattice diamond ${alat} orient x 1 1 0 orient y 0 0 -1 orient z -1 1 0" &
    "variable ylat_hi equal 20" &
    "variable slab_hi equal 670"
if "${orientation} == 111" then &
    "lattice diamond ${alat} orient x 1 -1 0 orient y 1 1 -2 orient z 1 1 1" &
    "variable ylat_hi equal 12" &
    "variable slab_hi equal 550"

variable    boxz_hi  equal ${slab_hi}+30
variable    ybath_lo equal ${ylat_hi}-1

region      box  block 0 20 0 ${ylat_hi} 0 ${boxz_hi} units lattice
create_box  2 box
region      slab block 0 20 0 ${ylat_hi} 10 ${slab_hi} units lattice
create_atoms 1 region slab

mass        1 12.011
mass        2 118.71          # unused; type 2 kept so the pair table matches

pair_style  hybrid tersoff/zbl zbl 3.5 4.5
pair_coeff  * * tersoff/zbl ${tersoff_pot} C NULL
pair_coeff  1 2 zbl 6.0 50
pair_coeff  2 2 zbl 50 50

group       diamond type 1

region      bath_xlo block INF 1 INF INF INF INF units lattice
region      bath_xhi block 19 20 INF INF INF INF units lattice
region      bath_ylo block INF INF INF 1 INF INF units lattice
region      bath_yhi block INF INF ${ybath_lo} ${ylat_hi} INF INF units lattice
region      bath_zlo block INF INF INF INF 11 13 units lattice
group       bath_geom region bath_xlo
group       bath_geom region bath_xhi
group       bath_geom region bath_ylo
group       bath_geom region bath_yhi
group       bath_geom region bath_zlo
group       bath_all intersect diamond bath_geom

region      anchor block INF INF INF INF 10 11 units lattice
group       anchor region anchor
# The bath must NOT contain anchor atoms.  `fix pin` zeroes their forces, so
# a Langevin kick on top turns them into free Brownian particles that wander
# out of the slab bottom and disorder the lowest few nm.  (The lateral skins
# span all heights, so 19% of the anchor used to be thermostatted: the 2026
# campaign lost ~700-950 atoms per run this way and carries ~4 nm of scaffold
# damage above the slab bottom, which the damage analysis excludes.)
group       bath subtract bath_all anchor

shell       mkdir -p ${outdir}

thermo      1000
thermo_style custom step time temp pe etotal press
thermo_modify lost warn flush yes

timestep    0.001
if "${temperature} > 0" then &
    "velocity diamond create ${temperature} ${seed_diamond} rot yes dist gaussian" &
    "fix eqbath diamond langevin ${temperature} ${temperature} 0.1 ${seed_eq} zero yes" &
    "fix eqdyn diamond nve" &
    "run ${warmup_steps}" &
    "unfix eqdyn" &
    "unfix eqbath" &
else &
    "minimize 1.0e-6 1.0e-8 2000 20000"

# Match the strike-phase boundary conditions so the reference relaxes the
# same way the production slabs do before their ion arrives.
velocity    anchor set 0.0 0.0 0.0
fix         pin  anchor setforce 0.0 0.0 0.0
fix         rbath bath langevin ${temperature} ${temperature} 0.1 ${seed_eq} zero yes
fix         rdyn  all nve
run         25000
unfix       rdyn
unfix       rbath
unfix       pin

write_data  ${outdir}/reference-orient${orientation}-T${temperature}.data
